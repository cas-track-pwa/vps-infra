# Copy to .env and fill in. .env is gitignored and is the single source of
# values used by scripts/provision.sh and the Caddyfile generation.

# --- Tailscale ---
# Full tailnet DNS name, e.g. yak-bebop.ts.net
TAILNET_NAME=

# --- GitHub repos (pinned ref recommended) ---
TIME_TRACKER_REPO=https://github.com/cas-track-pwa/time-tracker.git
TIME_TRACKER_REF=master
ITFLOW_REPO=https://github.com/cas-track-pwa/itflow.git
ITFLOW_REF=invoice-create-api

# --- Paths ---
TRACKER_WEBROOT=/srv/tracker
ITFLOW_WEBROOT=/var/www/itflow
ITFLOW_BACKEND=http://127.0.0.1:8080
SYNC_DIR=/opt/time-tracker/server

# --- Sync service ---
# Generate with: openssl rand -hex 32 (reuse the old Worker's JWT_SECRET to keep sessions)
JWT_SECRET=
# Single-quote the JSON so quotes survive systemd/Node env parsing.
FALLBACK_ALLOWED_USERS='["you@example.com"]'
PORT=8787

# --- Bridge (written into the tracker webroot config.php) ---
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=
ITFLOW_API_KEY=
DEFAULT_CATEGORY_ID=0
